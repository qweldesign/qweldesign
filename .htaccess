# サイト全体の設定 (Apache)

# 設定ファイル (共通・本家・工房) は直接公開しない
<FilesMatch "^(config|config-common|studio-config)\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # サイトのルートの URL (例: /tools/simple-cms/) を BASE に入れる
  RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
  RewriteRule ^(.*)$ - [E=BASE:%1]

  # サイトマップは sitemap.php が content/ から自動で作る
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # 旧 URL からの転送
  RewriteRule ^tools/contact-form(/.*)?$ %{ENV:BASE}contact/ [R=301,L]
</IfModule>
